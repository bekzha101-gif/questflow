# ─── QuestFlow Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — add it to .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Cloud Database & Auth) ─────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# ── Google OAuth (required for "Sign in with Google" button in Supabase) ──────
# Set this in Supabase Dashboard → Authentication → Providers → Google
# Then paste your Google Client ID here too (for reference):
# VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ── Optional: AI Features ─────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# VITE_GEMINI_API_KEY=AIzaSy...

# ── Optional: YouTube Analytics ───────────────────────────────────────────────
# VITE_YOUTUBE_API_KEY=AIzaSy...
