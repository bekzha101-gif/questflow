# QuestFlow сервер (Telegram-бот и расписания). Только имена переменных.
# Значения вводятся в `npm run setup` и пишутся в server/.env (он в .gitignore).
# Никогда не вписывай сюда настоящие значения.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Адрес проекта Supabase (Settings → API → Project URL)
SUPABASE_URL=
# service_role ключ Supabase (Settings → API). Только на этом компьютере, никогда в сайт.
SUPABASE_SERVICE_ROLE_KEY=
# UID владельца в Supabase (Authentication → Users)
OWNER_USER_ID=
# Необязательно: ключ Claude API — запасной путь, если `claude -p` недоступен
ANTHROPIC_API_KEY=
